lookup AlternateSubstitution2 {
    lookupflag 0;
    ;
    # Original source: 1 
    sub g from [g.alt01 g.alt02];
    sub zero from [zero.alt01 zero.alt02];
    sub tilde from [tilde.alt01 tilde.case tilde.alt01.case];
    sub breve from [breve.cyrl breve.case breve.cyrl_case];
} AlternateSubstitution2;

